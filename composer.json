{
  "name": "multi-vendor-marketplace/woocommerce",
  "description": "Production-grade multi-vendor marketplace for WooCommerce",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Marketplace Team",
      "email": "dev@marketplace.example.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "composer/installers": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "wp-coding-standards/wpcs": "^3.0",
    "phpcompatibility/php-compatibility": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "MultiVendorMarketplace\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MultiVendorMarketplace\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
